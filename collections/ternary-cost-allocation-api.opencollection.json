        {
          "info": {
            "name": "Delete Cost Allocation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ternary.app/v1/cost-allocations/:allocation_id",
            "params": [
              {
                "name": "allocation_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the cost allocation rule"
              }
            ]
